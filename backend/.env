APP_ENV=development
APP_SECRET_KEY=dev-secret-key-openssl-rand-hex-32-12345678
DB_URL=sqlite+aiosqlite:///./data/truthlens.db
DB_ECHO=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
RATE_LIMIT_ENABLED=false

# Ollama models (use available local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_RERANK_MODEL=nomic-embed-text
