# ─── App ─────────────────────────────────────────────────────────
APP_NAME=VeritasRAG
APP_VERSION=0.1.0
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-openssl-rand-hex-32
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ─── Server ──────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_MAX_UPLOAD_SIZE=52428800

# ─── Database ────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./data/truthlens.db
DB_ECHO=false

# ─── ChromaDB ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb

# ─── Ollama ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=phi3:3b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.3

# ─── Embeddings ──────────────────────────────────────────────────
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBED_DEVICE=cpu
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ─── Retrieval ───────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_K=5
RETRIEVAL_MIN_SCORE=0.3

# ─── Guardrail ───────────────────────────────────────────────────
GUARDRAIL_THRESHOLD=0.7
GUARDRAIL_MAX_RETRIES=3
GUARDRAIL_NLI_MODEL=microsoft/deberta-v3-base

# ─── Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=veritasrag

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ─── Data Paths ──────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
BM25_INDEX_DIR=./data/bm25

# ─── PII ─────────────────────────────────────────────────────────
PII_REDACTION_ENABLED=true
PII_ENTITIES=EMAIL,PHONE,SSN,CREDIT_CARD,ADDRESS
