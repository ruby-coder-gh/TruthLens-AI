# ─── App ─────────────────────────────────────────────────────────
APP_NAME=VeritasRAG
APP_VERSION=0.1.0
APP_ENV=development
APP_SECRET_KEY=<generate-with-openssl-rand-hex-32>
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ─── Server ──────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_MAX_UPLOAD_SIZE=52428800

# ─── Database ────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./data/truthlens.db
DB_ECHO=false

# ─── ChromaDB ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb

# ─── Ollama ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_RERANK_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096

# ─── Embeddings ──────────────────────────────────────────────────
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBED_DEVICE=cpu
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ─── Retrieval ───────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_K=5
RETRIEVAL_MIN_SCORE=0.3

# ─── Multimodal (vision) ────────────────────────────────────────
MULTIMODAL_ENABLED=true
MULTIMODAL_MAX_IMAGES=10

# ─── Guardrail ───────────────────────────────────────────────────
GUARDRAIL_THRESHOLD=0.7
GUARDRAIL_MAX_RETRIES=3
GUARDRAIL_NLI_MODEL=cross-encoder/nli-deberta-v3-base

# ─── Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=veritasrag

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ─── Data Paths ──────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
BM25_INDEX_DIR=./data/bm25

# ─── Trust Score Weights ─────────────────────────────────────────
TRUST_RETRIEVAL_WEIGHT=0.3
TRUST_FAITHFULNESS_WEIGHT=0.4
TRUST_RELEVANCE_WEIGHT=0.2
TRUST_SOURCE_WEIGHT=0.1

# ─── Human Review Queue ───────────────────────
REVIEW_QUEUE_TRUST_THRESHOLD=0.5
QUERY_PIN_LIMIT=20

# ─── Usage & Cost Reporting ───────────────────
# JSON map of model name -> {"input_per_1k": float, "output_per_1k": float}
MODEL_PRICING_JSON={"gpt-4o-mini":{"input_per_1k":0.00015,"output_per_1k":0.0006}}

# ─── Audit Export ─────────────────────────────
AUDIT_EXPORT_MAX_ROWS=50000

# ─── Query Rewriting ─────────────────────────────────────────────
REWRITE_ENABLED=true
REWRITE_TEMPERATURE=0.2
REWRITE_MAX_TOKENS=256

# ─── Query Cache ─────────────────────────────────────────────────
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600

# ─── WebSocket Stream Resume ─────────────────────────────────────
# How long a finished /ws/query stream stays replayable after its last frame
# (seconds), and the max number of per-query replay buffers held in memory.
WS_RESUME_TTL_SECONDS=120
WS_RESUME_MAX_BUFFERS=500
# Frame ceiling per stream. One streamed token is one frame (~410 B), so 1500
# caps a single buffer near 0.6 MB and the registry near 300 MB at the worst
# case of 500 full buffers. A stream past the ceiling keeps streaming but stops
# being resumable (buffer released) — it is never truncated, which would leave
# gaps in `seq`. Lower this first if memory matters more than resumability.
WS_RESUME_MAX_FRAMES_PER_BUFFER=1500
# Concurrent in-flight /ws/query pipelines per user. A disconnect no longer
# cancels the pipeline, so this is what bounds repeated connect-query-drop
# cycles; starting one past the cap cancels that user's oldest live stream.
WS_MAX_INFLIGHT_PER_USER=3
# Seconds shutdown waits for detached pipelines to finish persisting before the
# database engine is disposed.
WS_SHUTDOWN_DRAIN_SECONDS=10

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ─── PII ─────────────────────────────────────────────────────────
PII_REDACTION_ENABLED=true
PII_ENTITIES=EMAIL,PHONE,SSN,CREDIT_CARD,ADDRESS
