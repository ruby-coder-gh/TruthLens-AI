# ─── App ─────────────────────────────────────────────────────────
APP_NAME=VeritasRAG
APP_VERSION=0.1.0
APP_ENV=development
APP_SECRET_KEY=<generate-with-openssl-rand-hex-32>
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ─── Server ──────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_MAX_UPLOAD_SIZE=52428800

# ─── Database ────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./data/truthlens.db
DB_ECHO=false

# ─── ChromaDB ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb

# ─── Ollama ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_RERANK_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096

# ─── Embeddings ──────────────────────────────────────────────────
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBED_DEVICE=cpu
# CAUTION: SUFFICIENCY_MIN_RERANK_SCORE below assumes a sigmoid-activated
# (num_labels==1) cross-encoder whose score lands in (0, 1). Swapping in a
# model that emits raw logits makes that floor meaningless — recalibrate it.
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ─── Retrieval ───────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_K=5
RETRIEVAL_MIN_SCORE=0.3

# ─── Evidence Sufficiency Gate ───────────────────────────────────
# Abstain ("I cannot find this information in your documents.") instead of
# generating when retrieval is too thin. Set SUFFICIENCY_GATE_ENABLED=false to
# restore the pre-gate behaviour of always generating.
SUFFICIENCY_GATE_ENABLED=true
# Floor on the cross-encoder rerank_score. BAAI/bge-reranker-v2-m3 has
# num_labels=1, so sentence-transformers applies a Sigmoid and the score is a
# relevance probability in (0, 1). 0.35 sits below the model's own 0.5 decision
# boundary (marginal matches still get answered) and far above the near-zero
# cluster of irrelevant chunks. Raise it for stricter refusals, lower it (>=0.1)
# to answer more often at the cost of weaker grounding.
SUFFICIENCY_MIN_RERANK_SCORE=0.35
# How many retrieved chunks must clear the floor before generation is allowed.
SUFFICIENCY_MIN_SUPPORTING=1

# ─── Multimodal (vision) ────────────────────────────────────────
MULTIMODAL_ENABLED=true
MULTIMODAL_MAX_IMAGES=10

# ─── Guardrail ───────────────────────────────────────────────────
GUARDRAIL_THRESHOLD=0.7
GUARDRAIL_MAX_RETRIES=3
GUARDRAIL_NLI_MODEL=cross-encoder/nli-deberta-v3-base

# ─── Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Ingest-time Prompt-Injection Quarantine (F7a) ────────────────
QUARANTINE_ENABLED=True
QUARANTINE_MIN_SEVERITY=high

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=veritasrag

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ─── Data Paths ──────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
BM25_INDEX_DIR=./data/bm25

# ─── Trust Score Weights ─────────────────────────────────────────
TRUST_RETRIEVAL_WEIGHT=0.3
TRUST_FAITHFULNESS_WEIGHT=0.4
TRUST_RELEVANCE_WEIGHT=0.2
TRUST_SOURCE_WEIGHT=0.1

# ─── Human Review Queue ───────────────────────
REVIEW_QUEUE_TRUST_THRESHOLD=0.5
QUERY_PIN_LIMIT=20

# ─── Usage & Cost Reporting ───────────────────
# JSON map of model name -> {"input_per_1k": float, "output_per_1k": float}
MODEL_PRICING_JSON={"gpt-4o-mini":{"input_per_1k":0.00015,"output_per_1k":0.0006}}

# ─── Audit Export ─────────────────────────────
AUDIT_EXPORT_MAX_ROWS=50000
# ─── Bulk Document Operations ─────────────────
BULK_REINDEX_CONCURRENCY=3

# ─── Query Rewriting ─────────────────────────────────────────────
REWRITE_ENABLED=false
REWRITE_TEMPERATURE=0.2
# Reasoning models (qwen3) can spend the whole budget inside a <think> block and
# return nothing; the pipeline then falls back to the original query. Raise the
# budget and bound the wait so a miss costs seconds, not a minute.
REWRITE_MAX_TOKENS=1024
REWRITE_TIMEOUT_SECONDS=12

# ─── Query Cache ─────────────────────────────────────────────────
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600

# ─── WebSocket Stream Resume ─────────────────────────────────────
# How long a finished /ws/query stream stays replayable after its last frame
# (seconds), and the max number of per-query replay buffers held in memory.
WS_RESUME_TTL_SECONDS=120
WS_RESUME_MAX_BUFFERS=500
# Frame ceiling per stream. One streamed token is one frame (~410 B), so 1500
# caps a single buffer near 0.6 MB and the registry near 300 MB at the worst
# case of 500 full buffers. A stream past the ceiling keeps streaming but stops
# being resumable (buffer released) — it is never truncated, which would leave
# gaps in `seq`. Lower this first if memory matters more than resumability.
WS_RESUME_MAX_FRAMES_PER_BUFFER=1500
# Concurrent in-flight /ws/query pipelines per user. A disconnect no longer
# cancels the pipeline, so this is what bounds repeated connect-query-drop
# cycles; starting one past the cap cancels that user's oldest live stream.
WS_MAX_INFLIGHT_PER_USER=3
# Seconds shutdown waits for detached pipelines to finish persisting before the
# database engine is disposed.
WS_SHUTDOWN_DRAIN_SECONDS=10

# ─── Evaluation ──────────────────────────────────────────────────
# Quality floors a prompt version's golden-set run must clear before it can be
# promoted (see /api/admin/prompts/{id}/promote).
EVAL_MIN_FAITHFULNESS=0.6
EVAL_MIN_TRUST=0.5
EVAL_MIN_CONTEXT_PRECISION=0.5
EVAL_REFUSAL_ACCURACY_MIN=0.7
# Age after which a run still marked `running` is treated as dead.
EVAL_RUN_STALE_SECONDS=1800
# Most approved reviewer-promoted entries a `subset=smoke` eval run includes
# (oldest first). Bounds any one contributor's share of the gate's metric means.
EVAL_SMOKE_PROMOTED_LIMIT=10

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ─── PII ─────────────────────────────────────────────────────────
PII_REDACTION_ENABLED=true
PII_ENTITIES=EMAIL,PHONE,SSN,CREDIT_CARD,ADDRESS
